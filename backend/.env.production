# Production Environment Variables for Hugging Face Spaces

# Database Configuration
# IMPORTANT: Set this in HF Space Secrets with your actual PostgreSQL connection string
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Authentication Configuration
# IMPORTANT: Set this in HF Space Secrets with a strong random secret
BETTER_AUTH_SECRET=your_production_secret_key_min_32_chars

# Application Environment
ENVIRONMENT=production

# Frontend URL (for CORS)
FRONTEND_URL=https://frontend-mocha-beta-73.vercel.app

# AI Chatbot Configuration (Phase III)
# IMPORTANT: Set these in HF Space Secrets
COHERE_API_KEY=your_cohere_api_key_here
OPENAI_COMPAT_BASE_URL=https://api.cohere.ai/v1
COHERE_MODEL_NAME=command-r-plus

# Optional: OpenAI API Key for future AI features
# OPENAI_API_KEY=sk-your-openai-api-key
